{
  "name": "zayon",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm --workspace apps/mobile run start",
    "android": "npm --workspace apps/mobile run android",
    "ios": "npm --workspace apps/mobile run ios",
    "convex": "node apps/mobile/scripts/runConvexDev.mjs",
    "typecheck": "npm --workspace apps/mobile run typecheck",
    "test": "npm --workspace apps/mobile run test",
    "lint": "npm --workspace apps/mobile run lint",
    "maestro:test": "npm --workspace apps/mobile run maestro:test",
    "maestro:smoke": "npm --workspace apps/mobile run maestro:smoke",
    "agent:smoke": "tsx scripts/agent-smoke.ts",
    "convex:dev": "npm --workspace apps/mobile run convex:dev",
    "convex:codegen": "npm --workspace apps/mobile run convex:codegen"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@typescript/native-preview": "7.0.0-dev.20260415.1",
    "convex": "^1.35.1",
    "expo": "54.0.33",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@ai-sdk/openai": "3.0.52",
    "@akshatgiri/convex-orchestrator": "^0.1.5",
    "@better-auth/expo": "1.5.6",
    "@convex-dev/agent": "0.6.1",
    "@convex-dev/better-auth": "0.11.4",
    "@convex-dev/migrations": "0.3.3",
    "@convex-dev/rag": "0.7.2",
    "@convex-dev/rate-limiter": "0.3.2",
    "@convex-dev/workpool": "^0.4.6",
    "ai": "6.0.158",
    "better-auth": "1.5.6",
    "zod": "^4.3.6"
  },
  "overrides": {
    "convex": "^1.35.1"
  }
}
